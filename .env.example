# Copier ce fichier en .env et remplir les valeurs (.env n'est jamais commité)

PORT=3000
# Origines autorisées (front), séparées par des virgules, pour HTTP et Socket.IO. Jamais "*".
CORS_ORIGIN=http://localhost:5173
# Seuil de log : debug (développement), info (production), warn (forte charge), silent
LOG_LEVEL=info
# Chemin de la base SQLite (par défaut : data/arch-rivals.db)
DB_PATH=data/arch-rivals.db

# Obligatoire, 32 caractères au moins. Générer une valeur aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Durée de validité du jeton (15m, 1h, 7d...)
JWT_EXPIRES_IN=1h

# Limitation de débit par adresse IP
# Requêtes par minute, toutes routes confondues
RATE_LIMIT_GLOBAL=300
# Tentatives de connexion et d'inscription par 15 minutes
RATE_LIMIT_AUTH=20

# Utilisés uniquement par `npm run seed:admin`
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@archrivals.local
ADMIN_PASSWORD=
