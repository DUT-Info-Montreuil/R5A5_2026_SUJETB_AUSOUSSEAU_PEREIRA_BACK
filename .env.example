# Copier ce fichier en .env et remplir les valeurs (.env n'est jamais commité)
# Aucune valeur secrète ne doit apparaître dans ce fichier

# development | production | test
NODE_ENV=development
PORT=3000
# Chemin de la base SQLite (par défaut : data/arch-rivals.db)
DB_PATH=data/arch-rivals.db

# Obligatoire. Au moins 32 octets aléatoires, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Le remplacer déconnecte tout le monde (voir README, « Rotation de la clé JWT »)
JWT_SECRET=

# Origines du front autorisées (CORS + vérification d'Origin), séparées par des virgules.
# Obligatoire en production, https:// uniquement. Défaut en dev : http://localhost:5173
CORS_ORIGINS=

# Cookies (refresh token et CSRF)
# Production, front et API sur deux domaines : COOKIE_SECURE=true, COOKIE_SAMESITE=none
# Dev local (localhost:5173 -> localhost:3000, même site) : COOKIE_SECURE=false, COOKIE_SAMESITE=lax
COOKIE_SECURE=
COOKIE_SAMESITE=
# Optionnel : domaine du cookie (laisser vide = domaine exact de l'API, recommandé)
COOKIE_DOMAIN=

# Nombre de reverse proxies devant l'API (laisser vide si l'API est exposée directement)
TRUST_PROXY=
# Redirige HTTP vers HTTPS (défaut : true en production)
FORCE_HTTPS=

# Détail des erreurs 500 dans la réponse. Interdit en production
DEBUG=false

# Limites de débit par IP et par minute (valeurs par défaut indiquées)
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=5
RATE_LIMIT_REFRESH_PER_MIN=10
RATE_LIMIT_CSRF_PER_MIN=30

# Utilisés uniquement par `npm run seed:admin`
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@archrivals.local
ADMIN_PASSWORD=
