# Copier ce fichier en .env et remplir les valeurs (.env n'est jamais commité)

PORT=3000
# Chemin de la base SQLite (par défaut : data/arch-rivals.db)
DB_PATH=data/arch-rivals.db

# Obligatoire. Générer une valeur aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Durée de validité du token (format ms : 15m, 1h, 7d...)
JWT_EXPIRES_IN=1h

# Utilisés uniquement par `npm run seed:admin`
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@archrivals.local
ADMIN_PASSWORD=
